@echo off
setlocal
set "SETUP_SELF=%~f0"
set "SETUP_TEMP=%TEMP%\CampTentPlannerSetup_%RANDOM%%RANDOM%"
mkdir "%SETUP_TEMP%" >nul 2>nul
powershell -NoProfile -ExecutionPolicy Bypass -Command "$self=$env:SETUP_SELF; $temp=$env:SETUP_TEMP; $lines=Get-Content -LiteralPath $self; $marker=[Array]::IndexOf($lines, '__PAYLOAD_BELOW__'); if ($marker -lt 0) { exit 2 }; $payload=($lines[($marker+1)..($lines.Length-1)] -join ''); $zip=Join-Path $temp 'payload.zip'; [IO.File]::WriteAllBytes($zip, [Convert]::FromBase64String($payload)); Expand-Archive -LiteralPath $zip -DestinationPath $temp -Force"
if errorlevel 1 (
    echo Setup could not extract its embedded files.
    pause
    exit /b 1
)
call "%SETUP_TEMP%\InstallInternal.cmd"
set "SETUP_RESULT=%ERRORLEVEL%"
rmdir /S /Q "%SETUP_TEMP%" >nul 2>nul
exit /b %SETUP_RESULT%
